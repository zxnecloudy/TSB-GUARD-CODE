--[[
    Delta Executor - TSB Guard (Rayfield UI)
    Features: Protection, Orbit, Dodge Attack, Auto Void, Player Protection, Face Target
]]

-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()

-- Load necessary libraries
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")

-- Configuration
local Config = {
    -- Protection Settings
    AntiKick = true,
    AntiTeleport = true,
    AntiBan = true,
    AntiCrash = true,
    RejoinOnKick = true,
    ProtectFromServerScripts = true,
    NotificationEnabled = true,
    
    -- Orbit Settings
    OrbitEnabled = true,
    OrbitSpeed = 10,
    OrbitDistance = 15,
    OrbitHeight = 0,
    AttackDirection = "Front",
    FaceTarget = true,
    
    -- Combat Settings
    AutoAttack = false,
    AttackCooldown = 0.5,
    TargetSelection = "Nearest",
    
    -- Dodge Settings
    DodgeEnabled = true,
    DodgeCooldown = 2,
    DodgeDistance = 20,
    DodgeDirection = "Random",
    
    -- Auto Void Settings
    AutoVoid = true,
    VoidCheckInterval = 0.5,
    VoidRecoveryHeight = 50,
    
    -- Player Protection Settings
    ProtectOthers = true,
    ProtectionRadius = 50,
    ProtectedPlayers = {},
    BlockDamageToProtected = true,
    TeleportProtectedToSafety = true
}

-- Create Rayfield Window
local Window = Rayfield:CreateWindow({
    Name = "TSB Guard",
    LoadingTitle = "TSB Guard",
    LoadingSubtitle = "by Delta",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "DeltaScripts",
        FileName = "TSB_Guard"
    },
    KeySystem = false,
    KeySettings = {
        Title = "TSB Guard",
        Url = "https://example.com/key",
        Note = "No key needed for this script"
    }
})

-- Main Protection System
local Protection = {}
Protection.__index = Protection

function Protection.new()
    local self = setmetatable({}, Protection)
    self.Player = Players.LocalPlayer
    self.OriginalPosition = nil
    self.IsProtected = true
    self.ProtectedConnections = {}
    return self
end

function Protection:SetupAntiKick()
    if not Config.AntiKick then return end
    
    local oldKick = self.Player.Kick
    self.Player.Kick = function(...)
        if self.IsProtected then
            self:Notify("TSB Guard", "Kick attempt blocked!")
            return
        end
        return oldKick(...)
    end
    
    local oldTeleport = TeleportService.Teleport
    TeleportService.Teleport = function(...)
        if self.IsProtected and Config.AntiTeleport then
            self:Notify("TSB Guard", "Teleport attempt blocked!")
            return
        end
        return oldTeleport(...)
    end
    
    if Config.ProtectFromServerScripts then
        local oldFireServer = game.ReplicatedStorage.RemoteEvent.FireServer
        game.ReplicatedStorage.RemoteEvent.FireServer = function(...)
            local args = {...}
            for _, arg in ipairs(args) do
                if type(arg) == "string" and (arg:lower():find("kick") or arg:lower():find("ban")) then
                    return
                end
            end
            return oldFireServer(...)
        end
    end
end

function Protection:SetupAntiTeleport()
    if not Config.AntiTeleport then return end
    
    self.OriginalPosition = self.Player.Character and self.Player.Character.PrimaryPart and self.Player.Character.PrimaryPart.Position
    
    self.ProtectedConnections[#self.ProtectedConnections+1] = RunService.Heartbeat:Connect(function()
        if self.Player.Character and self.Player.Character.PrimaryPart then
            local currentPos = self.Player.Character.PrimaryPart.Position
            if self.OriginalPosition and (currentPos - self.OriginalPosition).Magnitude > 1000 then
                self.Player.Character.PrimaryPart.CFrame = CFrame.new(self.OriginalPosition)
                self:Notify("TSB Guard", "Teleport detected, position restored!")
            end
        end
    end)
end

function Protection:SetupAntiBan()
    if not Config.AntiBan then return end
    
    local oldBan = game.Players.BanAsync
    game.Players.BanAsync = function(...)
        if self.IsProtected then
            self:Notify("TSB Guard", "Ban attempt blocked!")
            return
        end
        return oldBan(...)
    end
    
    if Config.RejoinOnKick then
        self.Player:Kick(function()
            if self.IsProtected then
                task.wait(2)
                TeleportService:Teleport(game.PlaceId, self.Player)
            end
        end)
    end
end

function Protection:SetupAntiCrash()
    if not Config.AntiCrash then return end
    
    local oldFireServer = game.ReplicatedStorage.RemoteEvent.FireServer
    game.ReplicatedStorage.RemoteEvent.FireServer = function(...)
        local args = {...}
        for _, arg in ipairs(args) do
            if type(arg) == "table" and #arg > 100 then
                return
            end
        end
        return oldFireServer(...)
    end
    
    RunService.Heartbeat:Connect(function()
        collectgarbage("collect")
    end)
end

function Protection:Notify(title, message)
    if Config.NotificationEnabled then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = message,
            Duration = 5
        })
    end
end

-- Player Protection System
local PlayerProtection = {}
PlayerProtection.__index = PlayerProtection

function PlayerProtection.new()
    local self = setmetatable({}, PlayerProtection)
    self.ProtectionConnection = nil
    self.DamageConnection = nil
    return self
end

function PlayerProtection:Start()
    if self.ProtectionConnection then return end
    
    self.ProtectionConnection = RunService.Heartbeat:Connect(function()
        if not Config.ProtectOthers then return end
        
        local localPlayer = Players.LocalPlayer
        local localChar = localPlayer.Character
        if not localChar or not localChar.PrimaryPart then return end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer and player.Character and player.Character.PrimaryPart then
                local dist = (player.Character.PrimaryPart.Position - localChar.PrimaryPart.Position).Magnitude
                
                if dist < Config.ProtectionRadius then
                    Config.ProtectedPlayers[player.Name] = true
                end
            end
        end
        
        if Config.TeleportProtectedToSafety then
            for name, isProtected in pairs(Config.ProtectedPlayers) do
                local player = Players:FindFirstChild(name)
                if player and player.Character and player.Character.PrimaryPart then
                    if player.Character.PrimaryPart.Position.Y < -50 then
                        local safePos = Vector3.new(player.Character.PrimaryPart.Position.X, Config.VoidRecoveryHeight, player.Character.PrimaryPart.Position.Z)
                        player.Character.PrimaryPart.CFrame = CFrame.new(safePos)
                    end
                end
            end
        end
    end)
    
    if Config.BlockDamageToProtected then
        local oldDamage = game.ReplicatedStorage.RemoteEvent.FireServer
        game.ReplicatedStorage.RemoteEvent.FireServer = function(...)
            local args = {...}
            for _, arg in ipairs(args) do
                if type(arg) == "table" then
                    for _, value in pairs(arg) do
                        if type(value) == "string" and Config.ProtectedPlayers[value] then
                            return
                        end
                    end
                end
            end
            return oldDamage(...)
        end
    end
end

-- Orbit System
local Orbit = {}
Orbit.__index = Orbit

function Orbit.new()
    local self = setmetatable({}, Orbit)
    self.Angle = 0
    self.Target = nil
    self.OrbitConnection = nil
    self.LastAttack = 0
    return self
end

function Orbit:GetTarget()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local dist = (player.Character.PrimaryPart.Position - Players.LocalPlayer.Character.PrimaryPart.Position).Magnitude
            
            if Config.TargetSelection == "Nearest" then
                if dist < closestDist then
                    closest = player
                    closestDist = dist
                end
            elseif Config.TargetSelection == "LowestHP" then
                if player.Character.Humanoid.Health < (closest and closest.Character.Humanoid.Health or math.huge) then
                    closest = player
                    closestDist = dist
                end
            elseif Config.TargetSelection == "Protected" then
                if Config.ProtectedPlayers[player.Name] then
                    closest = player
                    break
                end
            end
        end
    end
    
    return closest
end

function Orbit:CalculatePosition(targetPosition)
    local player = Players.LocalPlayer
    local char = player.Character
    local root = char and char.PrimaryPart
    
    if not root or not targetPosition then return nil end
    
    local angle = math.rad(self.Angle)
    local x = math.cos(angle) * Config.OrbitDistance
    local z = math.sin(angle) * Config.OrbitDistance
    
    local targetCFrame = CFrame.new(targetPosition)
    local offset = Vector3.new(x, Config.OrbitHeight, z)
    
    local directionOffset = Vector3.new(0, 0, 0)
    if Config.AttackDirection == "Front" then
        directionOffset = targetCFrame.LookVector * Config.OrbitDistance
    elseif Config.AttackDirection == "Back" then
        directionOffset = -targetCFrame.LookVector * Config.OrbitDistance
    elseif Config.AttackDirection == "Left" then
        directionOffset = -targetCFrame.RightVector * Config.OrbitDistance
    elseif Config.AttackDirection == "Right" then
        directionOffset = targetCFrame.RightVector * Config.OrbitDistance
    elseif Config.AttackDirection == "Top" then
        directionOffset = Vector3.new(0, Config.OrbitDistance, 0)
    elseif Config.AttackDirection == "Bottom" then
        directionOffset = Vector3.new(0, -Config.OrbitDistance, 0)
    end
    
    local finalPosition = targetPosition + offset + directionOffset
    
    local lookAt
    if Config.FaceTarget then
        lookAt = CFrame.lookAt(finalPosition, targetPosition)
    else
        lookAt = CFrame.new(finalPosition) * root.CFrame.Rotation
    end
    
    return lookAt
end

function Orbit:Start()
    if self.OrbitConnection then return end
    
    self.OrbitConnection = RunService.RenderStepped:Connect(function(deltaTime)
        if not Config.OrbitEnabled then return end
        
        local player = Players.LocalPlayer
        local char = player.Character
        local root = char and char.PrimaryPart
        
        if not root then return end
        
        self.Target = self:GetTarget()
        if not self.Target or not self.Target.Character then return end
        
        local targetRoot = self.Target.Character.PrimaryPart
        if not targetRoot then return end
        
        self.Angle = (self.Angle + Config.OrbitSpeed * deltaTime * 10) % 360
        
        local newCFrame = self:CalculatePosition(targetRoot.Position)
        if newCFrame then
            root.CFrame = newCFrame
        end
        
        if Config.AutoAttack and tick() - self.LastAttack > Config.AttackCooldown then
            self:Attack()
            self.LastAttack = tick()
        end
    end)
end

function Orbit:Attack()
    local player = Players.LocalPlayer
    local char = player.Character
    
    if not char then return end
    
    local combatRemote = nil
    for _, child in ipairs(game.ReplicatedStorage:GetChildren()) do
        if child.Name:lower():find("attack") or child.Name:lower():find("combat") or child.Name:lower():find("skill") then
            combatRemote = child
            break
        end
    end
    
    if combatRemote then
        combatRemote:FireServer("BasicAttack")
    end
    
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

function Orbit:Stop()
    if self.OrbitConnection then
        self.OrbitConnection:Disconnect()
        self.OrbitConnection = nil
    end
end

-- Dodge System
local Dodge = {}
Dodge.__index = Dodge

function Dodge.new()
    local self = setmetatable({}, Dodge)
    self.LastDodge = 0
    return self
end

function Dodge:PerformDodge()
    local player = Players.LocalPlayer
    local char = player.Character
    local root = char and char.PrimaryPart
    
    if not root or not Config.DodgeEnabled then return end
    
    if tick() - self.LastDodge < Config.DodgeCooldown then return end
    
    local dodgeDirection = Vector3.new()
    
    if Config.DodgeDirection == "Random" then
        dodgeDirection = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)).Unit
    elseif Config.DodgeDirection == "Backward" then
        dodgeDirection = -root.CFrame.LookVector
    elseif Config.DodgeDirection == "Forward" then
        dodgeDirection = root.CFrame.LookVector
    elseif Config.DodgeDirection == "Sideways" then
        dodgeDirection = root.CFrame.RightVector * (math.random() > 0.5 and 1 or -1)
    end
    
    local targetPosition = root.Position + dodgeDirection * Config.DodgeDistance
    
    local tween = TweenService:Create(root, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        CFrame = CFrame.new(targetPosition) * root.CFrame.Rotation
    })
    tween:Play()
    
    self.LastDodge = tick()
end

-- Auto Void System
local AutoVoid = {}
AutoVoid.__index = AutoVoid

function AutoVoid.new()
    local self = setmetatable({}, AutoVoid)
    self.VoidConnection = nil
    self.IsRecovering = false
    return self
end

function AutoVoid:Start()
    if self.VoidConnection then return end
    
    self.VoidConnection = RunService.Heartbeat:Connect(function()
        if not Config.AutoVoid then return end
        
        local player = Players.LocalPlayer
        local char = player.Character
        local root = char and char.PrimaryPart
        
        if not root then return end
        
        if root.Position.Y < -50 and not self.IsRecovering then
            self.IsRecovering = true
            
            local safePosition = Vector3.new(root.Position.X, Config.VoidRecoveryHeight, root.Position.Z)
            root.CFrame = CFrame.new(safePosition)
            
            if char:FindFirstChild("Humanoid") then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            
            task.wait(1)
            self.IsRecovering = false
        end
    end)
end

-- Initialize Systems
local protection = Protection.new()
protection:SetupAntiKick()
protection:SetupAntiTeleport()
protection:SetupAntiBan()
protection:SetupAntiCrash()

local orbit = Orbit.new()
orbit:Start()

local dodge = Dodge.new()
local autoVoid = AutoVoid.new()
autoVoid:Start()

local playerProtection = PlayerProtection.new()
playerProtection:Start()

